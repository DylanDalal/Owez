{
  "name": "owez",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:shared": "pnpm --filter @owez/shared build",
    "dev:web": "pnpm --filter @owez/web dev",
    "dev:mobile": "pnpm --filter @owez/mobile start",
    "dev:functions": "pnpm --filter @owez/functions build:watch",
    "build:functions": "pnpm --filter @owez/functions build",
    "emulators": "firebase emulators:start",
    "emulators:firestore": "firebase emulators:start --only firestore,auth",
    "test": "pnpm --filter @owez/tests test",
    "test:unit": "pnpm --filter @owez/tests test:unit",
    "test:rules": "pnpm --filter @owez/tests test:rules",
    "test:integration": "pnpm --filter @owez/tests test:integration"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
