{
  "name": "owez",
  "private": true,
  "version": "0.0.1",
  "description": "Owez — snap a receipt, split the bill, get paid.",
  "scripts": {
    "build:shared": "pnpm --filter @owez/shared build",
    "dev:web": "pnpm --filter @owez/web dev",
    "dev:mobile": "pnpm --filter @owez/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
