# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are bundled into the JS.

# ---- Where to hit the Next.js API routes (receipt parsing lives there) ----
#
# iOS simulator / web dev: localhost works because the simulator shares the
# Mac's network stack with the host.
#
# Physical iPhone via Expo Go: use your Mac's LAN IP (find it with
# `ipconfig getifaddr en0`) because "localhost" on the phone means the phone.
#
# Prod: https://owez.vercel.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Origin used to build shareable bill URLs (e.g. /b/{billId}). This is the
# web app's origin — the same URL friends will open in their browser.
# Same localhost vs LAN IP rule as above.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

MINDEE_API_KEY=md_a7ZExyzqEYwzsbQH67jczdU0GWvYzbC4M0rYgKXq_qw
MINDEE_MODEL_ID=3057ab6f-b659-4d69-a687-e9beec129ecd

