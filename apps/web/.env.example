# Copy to .env.local and fill in.

# ---- OpenAI V2 (server-only, free tier) ----
# 1. Sign up at https://platform.openai.com/
# 2. Create an API key (v2) → copy here
# 3. Pick a receipt model (Expense Receipts OTS, or a custom one) → copy its
#    model_id (a UUID) here
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=

# ---- Firebase (public client config) ----
# Firebase Console → Project settings → General → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to route Auth/Firestore/Storage through the local emulator suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---- Google AdSense (optional — ads fund OpenAI credits) ----
# 1. Sign up at https://adsense.google.com/
# 2. Get your publisher ID (looks like "ca-pub-1234567890123456")
# 3. Create two ad units in your AdSense dashboard:
#    - One for the parsing wait screen (rectangle / responsive)
#    - One for the claim page banner (fluid / horizontal)
# 4. Copy the numeric slot IDs below.
# Leave blank to run ad-free (component renders nothing without a pub ID).
NEXT_PUBLIC_ADSENSE_PUB_ID=
NEXT_PUBLIC_AD_SLOT_PARSING=
NEXT_PUBLIC_AD_SLOT_CLAIM_BANNER=
