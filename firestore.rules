rules_version = '2';

// Owez Firestore security rules.
//
// Model:
//  - tabs/{tabId}                   — tab doc (multi-receipt group for a night
//                                     out or a trip), owned by creator.
//  - bills/{billId}                 — bill doc (single receipt), owned by its creator.
//                                     can optionally reference a tab via tabId.
//  - bills/{billId}/claims/{claimId} — one doc per (itemId, unitIndex) claim.
//                                     doc id is auto-generated; `claimerId`
//                                     field is pinned to request.auth.uid.
//  - users/{uid}                    — user profile (payment handles, photo).
//                                     Only the owner reads it; bills carry a
//                                     denormalized creatorName/creatorPhotoURL
//                                     so claim pages never need it.
//  - parseUsage/{uid}               — server-only rate-limit counters. No rule
//                                     matches it, so clients are denied.
//
// Design notes:
//  - Anyone who knows a bill/tab id can GET it, since the whole point is that
//    the creator shares links with friends. Security relies on id
//    unguessability — which only holds if nobody can LIST the collection.
//    So `get` is public but `list` is restricted to queries scoped to the
//    caller's own documents (or to a known tabId).
//  - Writing tabs/bills requires auth and request.auth.uid == creatorId, except
//    that any authenticated viewer may append themselves to a tab's member list
//    (members/updatedAt only, and only by growing the list).
//  - Each claim doc stores its claimerId as a field; rules make sure it
//    matches the authenticated uid on create/update.
//  - Tab/Bill creators can delete any claim on their own tab/bill (for cleanup).
//    Anonymous friends can only touch their own claims.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(data) {
      return signedIn() && request.auth.uid == data.creatorId;
    }

    match /users/{uid} {
      // Profiles hold email + phone — owner only.
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /tabs/{tabId} {
      allow get: if true;
      // Dashboard query: where creatorId == me.
      allow list: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
                    && request.resource.data.id == tabId;

      // Creator can edit freely. Any signed-in viewer may also update, but
      // only to append to the member list — they may touch `members` and
      // `updatedAt`, and the new list must still contain every existing member.
      allow update: if signedIn()
                    && (
                      isOwner(resource.data)
                      || (
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['members', 'updatedAt'])
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.resource.data.members.size() <= 200
                      )
                    );

      allow delete: if isOwner(resource.data);
    }

    match /bills/{billId} {
      allow get: if true;
      // Two list shapes exist: the dashboard (where creatorId == me) and the
      // tab page (where tabId == <known tab>). Anything broader is denied, so
      // nobody can dump every bill and its payment handles.
      allow list: if signedIn()
                  && (
                    request.auth.uid == resource.data.creatorId
                    || resource.data.tabId is string
                  );

      allow create: if isOwner(request.resource.data)
                    && request.resource.data.id == billId;

      allow update, delete: if isOwner(resource.data);

      match /claims/{claimId} {
        // Scoped to one bill, so listing here is fine.
        allow read: if true;

        // Create: authenticated user, writing their own claimerId, with a
        // sanity-checked shape.
        allow create: if signedIn()
                      && request.resource.data.claimerId == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'itemId', 'unitIndex', 'portions', 'splitInto',
                           'claimerId', 'name', 'initials', 'createdAt',
                           'photoURL', 'duplicate'
                         ])
                      && request.resource.data.portions is int
                      && request.resource.data.portions >= 1
                      && request.resource.data.splitInto is int
                      && request.resource.data.splitInto >= 1
                      && request.resource.data.splitInto <= 50
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 80;

        // Update: claimer can adjust their own portions/split only.
        allow update: if signedIn()
                      && resource.data.claimerId == request.auth.uid
                      && request.resource.data.claimerId == request.auth.uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['portions', 'splitInto'])
                      && request.resource.data.portions >= 1
                      && request.resource.data.splitInto >= 1
                      && request.resource.data.splitInto <= 50;

        // Delete: claimer themselves OR the bill creator (for cleanup).
        allow delete: if signedIn()
                      && (resource.data.claimerId == request.auth.uid
                          || get(/databases/$(database)/documents/bills/$(billId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
